# ============================================
# CloudViz Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.
# ============================================

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/cloudviz?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Demo Mode - set true to enable the zero-cost demo cloud adapter
DEMO_MODE=true

# Monitoring scheduler interval in cron syntax (default: every 5 minutes)
MONITORING_CRON=*/5 * * * *

# ---------------- AWS (optional - only needed for AWS Live Mode) ----------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Set true only if you accept the $0.01/request Cost Explorer charge
AWS_ENABLE_COST_EXPLORER=false

# ---------------- OCI (optional - only needed for OCI Live Mode) ----------------
OCI_TENANCY=
OCI_USER_ID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_REGION=

# ---------------- Email / Alerts (optional but recommended) ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=CloudViz Alerts <alerts@example.com>

# ---------------- Demo seed script (optional) ----------------
# Used only by `npm run seed:demo` to create a ready-to-login demo account.
SEED_DEMO_EMAIL=demo@cloudviz.local
SEED_DEMO_PASSWORD=demopassword123
